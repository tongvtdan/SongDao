  "action_rules": [
    {
      "id": "feast_witness_vi",
      "locale": "vi",
      "enabled": true,
      "priority": 15,
      "when": {"is_feast": true},
      "action": {"type": "reflection", "title": "Sống chứng tá của ngày lễ", "short_title": "Một chứng tá nhỏ", "duration_minutes": 5, "prompt": "Chọn một cách rất nhỏ để làm chứng cho đức tin hôm nay: một lời tử tế, một việc phục vụ, hoặc một lời cầu cho người cần nâng đỡ.", "proof_type": "self_check"},
      "source": {"name": "SongDao core actions", "license": "internal"}
    },
    {
      "id": "easter_weekday_spirit_note_vi",
      "locale": "vi",
      "enabled": true,
      "priority": 45,
      "when": {"season": "easter", "is_sunday": false},
      "action": {"type": "reflection", "title": "Lắng nghe Chúa Thánh Thần", "short_title": "Một câu lắng nghe", "duration_minutes": 5, "prompt": "Đọc tham chiếu Tin Mừng hôm nay, rồi viết một câu: Chúa đang mời tôi sống điều gì cụ thể trong ngày này?", "proof_type": "private_note"},
      "source": {"name": "SongDao core actions", "license": "internal"}
    },
    {
      "id": "post_demo_friday_service_vi",
      "locale": "vi",
      "enabled": true,
      "priority": 35,
      "when": {"weekday": "friday", "is_sunday": false},
      "action": {"type": "sacrifice", "title": "Hy sinh bằng một việc phục vụ", "short_title": "Một việc phục vụ", "duration_minutes": 5, "prompt": "Chọn một điều nhỏ để nhường, tiết chế, hoặc phục vụ âm thầm trong hôm nay.", "proof_type": "self_check"},
      "source": {"name": "SongDao core actions", "license": "internal"}
    },
    {
      "id": "post_demo_sunday_mass_intention_vi",
      "locale": "vi",
      "enabled": true,
      "priority": 20,
      "when": {"weekday": "sunday", "is_sunday": true},
      "action": {"type": "mass_preparation", "title": "Chuẩn bị một ý lễ", "short_title": "Ý lễ hôm nay", "duration_minutes": 3, "prompt": "Trước Thánh lễ hoặc giờ cầu nguyện Chúa nhật, hãy chọn một người hay một việc để dâng lên Chúa.", "proof_type": "self_check"},
      "source": {"name": "SongDao core actions", "license": "internal"}
    },
    {
      "id": "post_demo_default_weekday_prayer_vi",
      "locale": "vi",
      "enabled": true,
      "priority": 100,
      "when": {"is_sunday": false, "is_solemnity": false},
      "action": {"type": "prayer", "title": "Một phút dâng ngày", "short_title": "Dâng ngày", "duration_minutes": 1, "prompt": "Dừng lại một phút, làm dấu Thánh Giá, và dâng một việc cụ thể của hôm nay cho Chúa.", "proof_type": "self_check"},
      "source": {"name": "SongDao core actions", "license": "internal"}
    }
  ],
  "prayers": [
    {
      "id": "loi_nguyen_truoc_cong_viec_vi",
